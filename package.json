{
  "name": "notations",
  "version": "1.1.0",
  "author": "Sriram Panyam",
  "description": "A package for modelling, parsing, laying out carnatic musical notation",
  "homepage": "https://github.com/panyam/notations#readme",
  "license": "ISC",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./web": {
      "types": "./lib/esm/web/index.d.ts",
      "import": "./lib/esm/web/index.js",
      "require": "./lib/cjs/web/index.js"
    },
    "./web/dockview": {
      "types": "./lib/esm/web/dockview.d.ts",
      "import": "./lib/esm/web/dockview.js",
      "require": "./lib/cjs/web/dockview.js"
    },
    "./styles/*": "./styles/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "lib/",
    "styles/",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panyam/notations.git"
  },
  "keywords": [
    "notation",
    "music",
    "carnatic"
  ],
  "bugs": {
    "url": "https://github.com/panyam/notations/issues"
  },
  "dependencies": {
    "@lume/kiwi": "^0.4.4",
    "@panyam/tsutils": "^1.0.0",
    "galore": "^1.0.7",
    "tlex": "^1.2.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "dockview-core": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "dockview-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@babel/core": "^8.1.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.5",
    "dockview-core": "^4.13.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.1",
    "markdown-it": "^15.0.3",
    "pre-commit": "^2.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.113.0",
    "webpack-bundle-analyzer": "^5.4.3",
    "webpack-cli": "^7.3.1"
  },
  "pre-commit": [
    "precommit-msg",
    "clean",
    "build",
    "check:esm",
    "lintfix",
    "test"
  ],
  "scripts": {
    "clean": "rm -Rf lib && jest --clearCache && rm -rf static/lib",
    "builddocs": "npx typedoc",
    "buildbase": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && node scripts/finalize-esm.mjs",
    "build:css": "mkdir -p dist && sass styles/NotationView.scss dist/NotationView.css --style=expanded && sass styles/NotationView.scss dist/NotationView.min.css --style=compressed",
    "build:umd": "webpack --mode=development && webpack --mode=production",
    "build:docs": "webpack --config docs/webpack.config.js --mode production",
    "build:docs:dev": "webpack --config docs/webpack.config.js --mode development",
    "build:docs:watch": "webpack --config docs/webpack.config.js --mode development --watch",
    "build": "npm run builddocs && npm run buildbase && npm run build:css && npm run build:umd",
    "test": "jest --coverage --runInBand",
    "check:esm": "node scripts/check-esm.mjs",
    "lint": "eslint src --quiet",
    "lintfix": "eslint src --quiet --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "precommit-msg": "echo 'Pre-commit checks...' && exit 0",
    "prepare": "npm run build",
    "prepublishOnly": "echo prepublishOnly...",
    "preversion": "npm run build && npm run lintfix",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "transcribe:photos": "tsx docs/scripts/transcribe-photos.ts"
  },
  "directories": {
    "lib": "lib"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": ">=20"
  }
}
